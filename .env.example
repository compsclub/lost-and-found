# API
PORT=3100
FRONTEND_ORIGIN=http://localhost:5273

# Database
#
# Default: the throwaway Prisma dev server (`pnpm dev:db`). It is disposable:
# `pnpm dev:db` prints its URL, and stopping it discards every row.
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
#
# Optional: the Docker container from db/compose.yml, which keeps its data.
DATABASE_URL=postgresql://lostfound:lostfound_dev@localhost:55432/lostfound

# Cloudinary (photo storage for report images)
# Copy the API environment variable from Cloudinary Console -> Settings ->
# API Keys, then fill in your own key and secret. Both development and
# production use the real Cloudinary API; the SDK never runs in the browser.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
CLOUDINARY_FOLDER=lost-and-found

# Alternatively, set the credentials individually; CLOUDINARY_URL wins when set.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Static build server (preview/server.ts)
PREVIEW_PORT=8080
API_TARGET=http://127.0.0.1:3100
