# API
PORT=3100
FRONTEND_ORIGIN=http://localhost:5273

# Database
#
# Default: the throwaway Prisma dev server (`pnpm dev:db`). It is disposable:
# `pnpm dev:db` prints its URL, and stopping it discards every row.
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
#
# Optional: the Docker container from db/compose.yml, which keeps its data.
DATABASE_URL=postgresql://lostfound:lostfound_dev@localhost:55432/lostfound

# Static build server (preview/server.ts)
PREVIEW_PORT=8080
API_TARGET=http://127.0.0.1:3100
