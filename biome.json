{
    "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/coverage",
            "!**/node_modules",
            "!src/generated",
            "!pnpm-lock.yaml",
            "!**/*.md",
            "!tests/mock",
            "!prisma/migrations"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "jsxQuoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "css": {
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        }
    },
    "assist": {
        "enabled": true
    }
}
