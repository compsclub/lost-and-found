{
    "name": "lost-and-found",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "concurrently --names api,web --prefix-colors blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
        "dev:api": "node --watch core/index.js",
        "dev:web": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start": "node core/index.js",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && pnpm test",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "cors": "^2.8.5",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "pg": "^8.23.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "prisma": "^7.10.1",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
