{
    "name": "lost-and-found",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "concurrently --names api,web --prefix-colors blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
        "dev:api": "tsx watch core/index.ts",
        "dev:web": "vite",
        "build": "pnpm typecheck && pnpm build:server && pnpm build:client",
        "build:server": "tsc -p tsconfig.backend.json",
        "build:client": "vite build",
        "preview": "vite preview",
        "start": "node dist/core/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && pnpm typecheck && pnpm test",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:studio": "prisma studio",
        "preview:serve": "tsx preview/server.ts"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "cors": "^2.8.5",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "pg": "^8.23.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.6",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "jsdom": "^31.0.1",
        "prisma": "^7.10.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    }
}
